{
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://127.0.0.1:8742"
      }
    }
  },
  "Bridge": {
    "MaxHistory": 256,
    "StaleSessionSeconds": 300,
    "StaleSweepSeconds": 30
  },
  "Adapters": {
    "Manual": { "Enabled": false },
    "Codex": { "Enabled": false },
    "ClaudeCode": { "Enabled": false },
    "CopilotCli": { "Enabled": false }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1"
}
