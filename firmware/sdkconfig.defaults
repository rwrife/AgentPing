# Both supported Waveshare boards have 16 MB flash.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_TLS_USING_MBEDTLS=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_LWIP_MAX_SOCKETS=10
CONFIG_FREERTOS_HZ=1000
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
# live3d only builds an image, two labels and a dot, so the default 64 KB LVGL
# pool is mostly idle. Shrinking it returns ~40 KB of SRAM to the IDF heap,
# which is what uploaded motion clips are allocated from.
CONFIG_LV_MEM_SIZE_KILOBYTES=24

CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
