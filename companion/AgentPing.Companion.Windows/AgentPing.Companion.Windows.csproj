<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>AgentPing.Companion</AssemblyName>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="..\AgentPing.Companion.Core\AgentPing.Companion.Core.csproj" /></ItemGroup>
  <ItemGroup><Content Include="..\..\docs\windows-troubleshooting.md" Link="docs\windows-troubleshooting.md" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
</Project>
